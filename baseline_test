from pathlib import Path

phases=[
("dense-general",.00,.03,.97,7000),("structured-sparse",.62,.18,.20,9000),
("geometric-heavy",.08,.78,.14,6000),("dense-general-2",.00,.04,.96,5500),
("hamiltonian-like",.73,.16,.11,8500),("rf-mixed",.10,.34,.56,6500),
("geometric-heavy-2",.05,.82,.13,5000),("state-space-like",.39,.24,.37,7500)]

A={"zero":.17,"geom":.27,"general":1.05}
B={"G":{"zero":.165,"geom":.265,"general":1.045},
   "S":{"zero":.090,"geom":.255,"general":1.085}}

# D shares EXACTLY the same G and S as B. Only R is new.
D={"G":dict(B["G"]),"S":dict(B["S"]),
   "R":{"zero":.060,"geom":.145,"general":1.145}}

shiftB={("G","S"):20,("S","G"):20}
shiftD={("G","S"):20,("S","G"):20,("G","R"):28,("R","G"):28,("S","R"):14,("R","S"):14}
OBSERVE=256; HYST=.025; HORIZON=1024

def avg(t,z,g,a): return z*t["zero"]+g*t["geom"]+a*t["general"]
def fixed(tab): return sum(n*avg(tab,z,g,a) for _,z,g,a,n in phases)

def adaptive(T,shift):
    m="G";tot=0.;sh=0;dec=[]
    for name,z,g,a,n in phases:
        ob=min(OBSERVE,n);tot+=ob*avg(T[m],z,g,a);rem=n-ob
        rates={q:avg(t,z,g,a) for q,t in T.items()}
        best=min(rates,key=rates.get);sw=False
        if best!=m and rem:
            rel=(rates[m]-rates[best])/rates[m]
            sc=shift[(m,best)]
            gain=(rates[m]-rates[best])*min(HORIZON,rem)
            if rel>=HYST and gain>1.25*sc:
                tot+=sc;m=best;sh+=1;sw=True
        tot+=rem*avg(T[m],z,g,a)
        dec.append((name,best,m,sw,rates))
    return tot,sh,dec

a=fixed(A)
b,sb,_=adaptive(B,shiftB)
d,sd,dec=adaptive(D,shiftD)

# Also run D with R disabled; it MUST equal B.
d_no_r,_,_=adaptive({"G":D["G"],"S":D["S"]},shiftB)

print("V5C FAIR-BASELINE TEST")
print(f"A fixed conventional     {a:.1f}")
print(f"B adaptive conventional  {b:.1f}   vs A {100*(a-b)/a:.2f}%")
print(f"D without R gear         {d_no_r:.1f}   delta vs B {100*(b-d_no_r)/b:.4f}%")
print(f"D with R gear            {d:.1f}   vs A {100*(a-d)/a:.2f}%   vs B {100*(b-d)/b:.2f}%")
print("Shifts B/D:",sb,sd)

print("\nD mode decisions")
for name,best,m,sw,r in dec:
    print(f"{name:22} best={best} selected={m} shift={sw} G={r['G']:.3f} S={r['S']:.3f} R={r['R']:.3f}")

# R-mode penalty break-even with G/S identical baseline
def dpen(p):
    T={"G":dict(D["G"]),"S":dict(D["S"]),"R":{k:v+p for k,v in D["R"].items()}}
    return adaptive(T,shiftD)[0]

lo,hi=0,.5
for _ in range(60):
    mid=(lo+hi)/2
    if dpen(mid)<b: lo=mid
    else: hi=mid
print(f"\nMaximum uniform additional R-mode cost before D ceases beating B: {lo:.4f}")

